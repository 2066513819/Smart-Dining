# ========================================
# 餐饮推荐系统环境变量配置
# ========================================
# 复制此文件为 .env 并填入实际值
# ========================================

# 数据库配置
# MySQL示例: mysql+pymysql://user:password@localhost:3306/database_name
# SQLite示例: sqlite:///./food_recommendation.db
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/food_recommendation

# JWT配置
# 密钥必须至少32个字符，建议使用随机生成的字符串
SECRET_KEY=your-super-secret-key-at-least-32-characters-long-for-security

# 加密算法，默认HS256
ALGORITHM=HS256

# Token过期时间（分钟），默认24小时（1440分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ========================================
# Dify AI服务配置
# ========================================

# 主推荐智能体配置
DIFY_API_KEY=app-your-dify-api-key-here
DIFY_API_URL=http://localhost/v1
DIFY_APP_ID=your-app-id

# 菜品分析智能体配置（可选）
DIFY_ANALYSIS_API_KEY=app-q4RpGmA6V71Gkk3H3T37zWiD
DIFY_ANALYSIS_API_URL=http://localhost:80/v1
DIFY_ANALYSIS_APP_ID=dish-analysis-app

# ========================================
# 应用配置
# ========================================

# 调试模式：生产环境请设置为false
DEBUG=false

# 应用名称
APP_NAME=餐饮推荐系统

# 应用版本
APP_VERSION=1.0.0

# ========================================
# CORS配置
# ========================================

# 允许的跨域来源，多个用逗号分隔
# 开发环境示例: http://localhost:5173,http://127.0.0.1:5173
# 生产环境示例: https://yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ========================================
# 文件上传配置
# ========================================

# 最大上传文件大小（字节），默认5MB
MAX_UPLOAD_SIZE=5242880

# 上传文件目录
UPLOAD_DIR=uploads

# ========================================
# 日志配置
# ========================================

# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
# 开发环境: DEBUG
# 生产环境: INFO
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE=app.log
